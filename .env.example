# ==============================================================================
# Fundur Workflows - Environment Configuration Template
# ==============================================================================

# Application URL (Vercel provides VERCEL_URL automatically in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL (Database & Connection Pooling)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API routes & Next.js:
DATABASE_URL="postgres://user:password@ep-sample-pooler.region.neon.tech/fundur_workflows?sslmode=require"
# Direct connection string for schema migrations:
DATABASE_URL_UNPOOLED="postgres://user:password@ep-sample.region.neon.tech/fundur_workflows?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTH0 (Authentication & Identity)
# ------------------------------------------------------------------------------
# Auth0 tenant domain (e.g. dev-xxxx.us.auth0.com or https://dev-xxxx.us.auth0.com)
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_ISSUER_BASE_URL="https://your-tenant.us.auth0.com"
# 32-byte secret generated via `openssl rand -hex 32`
AUTH0_SECRET="replace-with-a-32-byte-hex-string-for-auth0-session-encryption"
# The base URL of your application
AUTH0_BASE_URL="http://localhost:3000"
# Auth0 Application Client ID & Client Secret
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_AUDIENCE=""
AUTH0_SCOPE="openid profile email"

# ------------------------------------------------------------------------------
# 3. REAL-TIME EVENT BUS (SSE & Optimistic State)
# ------------------------------------------------------------------------------
# Heartbeat interval in milliseconds for Server-Sent Events (default: 15000ms)
REALTIME_HEARTBEAT_INTERVAL_MS="15000"
# Autosave debounce threshold in milliseconds (default: 800ms)
NEXT_PUBLIC_AUTOSAVE_DEBOUNCE_MS="800"

# ------------------------------------------------------------------------------
# 4. ADMIN AND AI SETTINGS
# ------------------------------------------------------------------------------
# AI provider keys and the default model are set by the Admin on /settings and
# stored encrypted in the database, not here.
# Who is platform Admin: a sign-in with one of these emails, verified by Auth0.
# Defaults to the account named in the build plan when unset.
PLATFORM_ADMIN_EMAILS=""
# 32 bytes (hex or base64) that encrypt stored keys. Optional: derived from
# AUTH0_SECRET when unset. Changing it means re-entering saved keys.
SETTINGS_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 5. FILE STORAGE (Vercel Blob, private; browsers upload straight to it)
# ------------------------------------------------------------------------------
# Set automatically when a Blob store is connected to the Vercel project.
# Without it, uploads record only the file name.
BLOB_READ_WRITE_TOKEN=""
